                 THROW_LAST_SYS_ERROR("unlink");
diff --git a/zen/format_unit.cpp b/zen/format_unit.cpp
index 2053e4d..b39db1a 100644
--- a/zen/format_unit.cpp
+++ b/zen/format_unit.cpp
@@ -170,7 +170,14 @@ std::wstring zen::formatNumber(int64_t n)
 {
     //::setlocale (LC_ALL, ""); -> see localization.cpp::wxWidgetsLocale
     static_assert(sizeof(long long int) == sizeof(n));
+#ifdef __amigaos__ //libnix's printf has no ' flag: group the digits here
+    std::wstring s = numberTo<std::wstring>(n);
+    for (size_t i = s.size(), d = (s.empty() || s[0] != L'-') ? 0 : 1; i > d + 3; )
+        s.insert(i -= 3, 1, L',');
+    return s;
+#else
     return printNumber<std::wstring>(L"%'lld", n); //considers grouping (')
+#endif
 }
 
 
